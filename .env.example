# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase (long-term memory)
# Project URL: dashboard > Integrations > Data API
# Secret key (sb_secret_...): dashboard > Settings > API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram (first-party interface)
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids. Empty = nobody is authorized.
ENDRA_ALLOWED_TELEGRAM_USERS=
# Where apps/telegram-adapter finds ENDRA Core. Defaults to localhost:3000.
CORE_BASE_URL=

# n8n / internal
N8N_BASE_URL=
N8N_API_KEY=
ENDRA_INTERNAL_SECRET=

# Proactive delivery (ADR-007) - Core -> telegram-adapter's local push endpoint.
# Must be the same value as ENDRA_INTERNAL_SECRET on both services.
TELEGRAM_PUSH_URL=http://127.0.0.1:3101/push
TELEGRAM_PUSH_PORT=3101

# Google OAuth (Gmail + Calendar tools, TOOLS-003/004)
# Client ID/secret: Google Cloud Console > APIs & Services > Credentials.
# Refresh token: obtained once via scripts/google-oauth-setup.mjs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
